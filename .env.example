# Platform foundations; no running controller is provided yet.
BOT_TOKEN=
OWNER_ID=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=multi_musicbot
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
MAX_ACTIVE_CALLS=1
MAX_QUEUE=20
# Optional integration test target; test creates/drops a random music_test_* database.
TEST_MONGODB_URI=
# Voice session generated locally into ignored .env.assistant. Never commit it.

# Private Phase 0 voice child only. Provision locally, never send these values in chat.
# API_ID=
# API_HASH=
# ASSISTANT_SESSION=
# VOICE_BOT_ID=
# VOICE_CHAT_ID=-100...
# VOICE_SESSION_ID=local-smoke
# VOICE_GENERATION=1
# VOICE_MEDIA_ROOT=/absolute/read-only/fixture/directory
# VOICE_MEDIA_HANDLES={"fixture-a":"audio-a.wav","fixture-b":"audio-b.wav"}
# VOICE_MAX_SECONDS=120
# Fixed binding + hard lifetime is NOT durable assistant allocation or lease renewal.

# Operator runner additionally requires these; no dotenv auto-loading:
# VOICE_ASSISTANT_ID=operator-provisioned-assistant
# VOICE_PYTHON=.venv-kurigram/bin/python
# Runner chooses child session/generation/deadline; do not set those manually for it.

# Required by authenticated operator playback. Generate a high-entropy grant locally;
# provision only its SHA-256 hash in worker_grants for the correct bot/owner.
# Provision matching bots and a stopped generation-0 workers slot separately.
# Never put the raw grant in command arguments, logs, audit or chat.
# WORKER_GRANT=

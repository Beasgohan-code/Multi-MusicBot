# Full single-container personal test. Put values in Render secrets, not Git/chat.
# Public URL and username must also be present during Docker BUILD.
PUBLIC_APP_URL=https://multi-musicbot.onrender.com
BOT_USERNAME=
API_ID=
API_HASH=
BOT_TOKEN=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_JWT_SECRET=
MONGO_URI=
REDIS_URL=
# Your Telegram numeric user ID (optional comma-separated admin IDs).
DEV_IDS=
# Defaults supplied by Dockerfile (Dockerfile.bot compatibility copy):
NODE_ENV=production
MONGO_DB=playeon_test
SESSION_NAME=/var/data/playeon-session
# Render provides PORT. Do not set DEV_MODE=1 or run another bot consumer.
